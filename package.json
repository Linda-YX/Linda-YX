{
  "name": "personal-finance-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "build:standalone": "node scripts/build-standalone.mjs",
    "build:pages": "tsc -b && vite build --base=/Linda-YX/",
    "deploy:pages": "npm run build:pages && node scripts/publish-pages.mjs"
  },
  "dependencies": {
    "papaparse": "^5.5.3",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.7.0",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "prettier": "^3.6.2",
    "typescript": "~5.9.3",
    "vite": "^7.1.9",
    "vitest": "^5.0.5"
  }
}
